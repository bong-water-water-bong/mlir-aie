
MEMORY
{
   program (RX) : ORIGIN = 0, LENGTH = 0x0020000
   data (!RX) : ORIGIN = 0x7D500, LENGTH = 0x2B00
}
ENTRY(__start)
SECTIONS
{
  . = 0x0;
  .text : {
     /* the __start symbol has to come at address zero. */
     *crt0.o(.text*)
     _ctors_start = .;
     _init_array_start = .;
     KEEP(SORT(*.init_array))
     _ctors_end = .;
     _init_array_end = .;
     _dtors_start = .;
     _dtors_end = .;
     *(.text*)
  } > program
  .data : {
     *(.data*)
     *(.rodata*)
  } > data
  .comment : {
     *(.comment*)
  }
  .symtab : {
     *(.symtab)
  }
  .shstrtab : {
     *(.shstrtab)
  }
  .strtab : {
     *(.strtab)
  }
  .stack_sizes : {
     *(.stack_sizes)
  }

. = 0x70000;
_sp_start_value_DM_stack = .;
. += 0xD00; /* stack */
/* No tile with memory exists to the south. */
. = 0x40000;
. += 0x10000;
/* No tile with memory exists to the west. */
. = 0x50000;
. += 0x10000;
. = 0x70D00;
memC_buff_0 = .;
. += 0x4000;
. = 0x74D00;
memC_buff_1 = .;
. += 0x4000;
. = 0x7CD00;
memW_cons_buff_0 = .;
. += 0x400;
. = 0x7D100;
memW_cons_buff_1 = .;
. += 0x400;
. = 0x78D00;
memA_cons_buff_0 = .;
. += 0x2000;
. = 0x7AD00;
memA_cons_buff_1 = .;
. += 0x2000;
  .bss : { *(.bss*) } > data
}
INPUT(aie_512_512x512x512_64x64x64.mlir.prj/bitnet_gemm_512_64x64x64.o)
PROVIDE(main = core_0_2);
